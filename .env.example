# Models
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

# API Keys
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
# DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Provider / model overrides
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

# Alibaba Cloud Model Studio OpenAI-compatible Qwen API.
# Setting DASHSCOPE_API_KEY selects this provider.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL_ID=qwen3-vl-plus
# DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
# DASHSCOPE_EMBEDDING_DIMENSIONS=0

# Optional OpenRouter compatibility overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_ID=
# OPENROUTER_EMBEDDING_MODEL=

# Storage (Optional)
# FRAME_STORE_PATH=data/frame_store.sqlite3

# Images are compressed before every chat or embedding API upload.
# LLM_MAX_IMAGE_SIZE_MB=5.0
# LLM_MAX_IMAGE_PIXELS=1638400
# LLM_MAX_VIDEO_BASE64_MB=10.0 (DashScope Base64 video limit; must be below this)

# Attach the latest finalized segment to visual query inspection.
# QUERY_INCLUDE_LATEST_SEGMENT_VIDEO=true
# QUERY_LATEST_SEGMENT_VIDEO_PATH=data/latest_segment.mp4

# EviReel P1 managed video assets (single server worker)
DATA_ROOT=data/evireel
MAX_UPLOAD_BYTES=1073741824
MAX_VIDEO_DURATION_S=10800
INDEX_CONCURRENCY=2
MAX_QUEUED_JOBS=20
PROBE_TIMEOUT_S=30
MEDIA_TIMEOUT_S=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ENABLE_EVENT_FINALIZE=true
ENABLE_LEGACY_HTTP_API=false

# Optional independent Embedding provider; keep credentials server-side.
# EMBEDDING_BASE_URL_OVERRIDE=https://your-compatible-provider/v1
# EMBEDDING_API_KEY_OVERRIDE=
# EMBEDDING_MODEL_OVERRIDE=
