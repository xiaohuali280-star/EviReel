# Models
# P3 retrieval: legacy is the Frame+Event raw-score comparison path.
RETRIEVAL_FUSION=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATES_PER_SOURCE=20
RETRIEVAL_MIN_SIMILARITY=0.05
RETRIEVAL_MAX_EVIDENCE=24
RETRIEVAL_NEIGHBOR_S=2
RETRIEVAL_INSPECT_FRAMES=6
RETRIEVAL_MAX_TURNS=4
RETRIEVAL_ANSWER_TEXT_CHARS=800
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_MODEL=rerank-v4.0-pro
RERANK_TIMEOUT_S=10
RERANK_CANDIDATES=20
RERANK_TEXT_CHARS=2000

# P2 speech transcription (optional: pip install -e ".[asr]")
ASR_ENABLED=true
ASR_MODEL=tiny
# Pin a model revision for reproducible remote-model identities.
ASR_MODEL_REVISION=
ASR_MODEL_CACHE=data/asr-models
# Default: fail explicitly if the configured model is not cached; no implicit downloads.
ASR_LOCAL_FILES_ONLY=true
ASR_LANGUAGE=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=2
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
ASR_TIMEOUT_S=900
ASR_MAX_SEGMENTS=20000
ASR_MAX_TEXT_CHARS=2000000
TRANSCRIPT_CHUNK_MAX_CHARS=500
TRANSCRIPT_CHUNK_MAX_DURATION_S=30
TRANSCRIPT_CHUNK_PAUSE_S=1.5

LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

# API Keys
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
# DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Provider / model overrides
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

# Alibaba Cloud Model Studio OpenAI-compatible Qwen API.
# Setting DASHSCOPE_API_KEY selects this provider.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL_ID=qwen3-vl-plus
# DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
# DASHSCOPE_EMBEDDING_DIMENSIONS=0

# Optional OpenRouter compatibility overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_ID=
# OPENROUTER_EMBEDDING_MODEL=

# Storage (Optional)
# FRAME_STORE_PATH=data/frame_store.sqlite3

# Images are compressed before every chat or embedding API upload.
# LLM_MAX_IMAGE_SIZE_MB=5.0
# LLM_MAX_IMAGE_PIXELS=1638400
# LLM_MAX_VIDEO_BASE64_MB=10.0 (DashScope Base64 video limit; must be below this)

# Attach the latest finalized segment to visual query inspection.
# QUERY_INCLUDE_LATEST_SEGMENT_VIDEO=true
# QUERY_LATEST_SEGMENT_VIDEO_PATH=data/latest_segment.mp4

# EviReel P1 managed video assets (single server worker)
DATA_ROOT=data/evireel
MAX_UPLOAD_BYTES=1073741824
MAX_VIDEO_DURATION_S=10800
INDEX_CONCURRENCY=2
MAX_QUEUED_JOBS=20
PROBE_TIMEOUT_S=30
MEDIA_TIMEOUT_S=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ENABLE_EVENT_FINALIZE=true
ENABLE_LEGACY_HTTP_API=false

# Optional independent Embedding provider; keep credentials server-side.
# EMBEDDING_BASE_URL_OVERRIDE=https://your-compatible-provider/v1
# EMBEDDING_API_KEY_OVERRIDE=
# EMBEDDING_MODEL_OVERRIDE=

# P4 persistent conversations (single server worker, no user accounts)
CONVERSATION_RECENT_TURNS=6
CONVERSATION_CONTEXT_CHARS=16000
CONVERSATION_CONTEXT_TOKENS=8000
CONVERSATION_MESSAGE_CHARS=2000
CONVERSATION_SUMMARY_CHARS=2000
CONVERSATION_SUMMARY_BATCH_TURNS=12
CONVERSATION_MODEL_TIMEOUT_S=30
CONVERSATION_REQUEST_TIMEOUT_S=180
CONVERSATION_MAX_RUNNING=4
CHAT_TEXT_CHARS=12000

# P5 web UI and durable notes (provider calls use the configured server key)
# FRONTEND_DIST=/absolute/path/to/custom/web-build
STUDY_AUTO_GENERATE=true
STUDY_MAX_RUNNING=2
STUDY_MAX_BATCHES=80
STUDY_BATCH_CHARS=10000
STUDY_TIMEOUT_S=600
STUDY_MODEL_TIMEOUT_S=180
STUDY_STREAM=true
STUDY_MODEL_ATTEMPTS=2
STUDY_MAX_EXPORT_PAGES=500

# E1 platform mode (resumable uploads, accounts, ownership, quota). Leave DATABASE_URL empty
# to keep the single-user local mode. Setup and migration: docs/engineering/E1_DELIVERY.md.
# Development values only; production needs a managed/secured PostgreSQL + S3, TLS (AUTH_COOKIE_SECURE=true)
# and secrets from a secret manager rather than this file.
# DATABASE_URL=postgresql://evireel:change-me@127.0.0.1:5432/evireel
# S3_ENDPOINT=http://127.0.0.1:9000          # used by the API server
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000   # host the browser uploads to (signed URLs)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=evireel
# S3_REGION=us-east-1
# S3_KEY_PREFIX=
# UPLOAD_PART_SIZE=8388608                   # >= 5 MiB; raised automatically to stay within 10,000 parts
# UPLOAD_SESSION_TTL_S=86400
# UPLOAD_URL_TTL_S=900                       # presigned part URL lifetime
# UPLOAD_LEASE_S=300                         # completion/verification lease before reconcile retries
# UPLOAD_MAX_ACTIVE_SESSIONS=5
# UPLOAD_VERIFY_ATTEMPTS=3
# UPLOAD_VERIFY_PART_ETAG=true               # set false for S3 encryption modes whose ETag is not MD5
# UPLOAD_RECONCILE_INTERVAL_S=60
# DEFAULT_WORKSPACE_QUOTA_BYTES=21474836480
# AUTH_SESSION_TTL_S=604800
# AUTH_COOKIE_SECURE=false

# E2 durable pipeline (platform mode only). PIPELINE_MODE=worker: jobs are accepted into PostgreSQL
# (jobs/stages/outbox) and executed by Celery workers fed by `python -m vam.pipeline.dispatcher`.
# Workers need Linux / containers (deploy/e2/compose.yml); API and workers must share DATA_ROOT.
# Development values only; production needs a managed RabbitMQ with TLS and its own credentials.
# PIPELINE_MODE=inline                       # inline = in-process indexer (default, single-user compatible)
# BROKER_URL=amqp://evireel:change-me@127.0.0.1:5672/evireel
# PIPELINE_LEASE_S=120                       # stage lease; workers heartbeat every lease/3
# PIPELINE_STAGE_MAX_ATTEMPTS=4              # per stage, then failed (failure ledger, manual retry)
# PIPELINE_RETRY_BASE_S=5                    # exponential backoff with jitter, capped:
# PIPELINE_RETRY_CAP_S=300
# PIPELINE_DISPATCH_INTERVAL_S=1             # outbox poll; recovery scan every 5 polls
# PIPELINE_REDISPATCH_AFTER_S=120            # pending stage never claimed -> dispatched again
# PIPELINE_TASK_TIME_LIMIT_S=10800           # Celery hard limit (soft = hard - min(60, 10%)); keep below
#                                            # RabbitMQ consumer_timeout (deploy/e2/rabbitmq.conf: 4 h)
# PIPELINE_EMBED_BATCH=32                    # transcript embedding batch = checkpoint granularity
# PIPELINE_SCRATCH=                          # worker scratch; default DATA_ROOT/.pipeline
# PIPELINE_ORPHAN_GRACE_S=3600               # unreferenced pipeline objects older than this are deleted
# PIPELINE_SWEEP_INTERVAL_S=600              # orphan sweep period (dispatcher process)

# E3 several API instances (deploy/e3/compose.yml). Correctness stays in PostgreSQL (job ledger, read
# model, read leases, tombstones, model usage); Redis carries only shared rate windows/slots, the
# query-vector cache and cross-instance notifications. API_MULTI_INSTANCE=true needs DATABASE_URL,
# PIPELINE_MODE=worker, REDIS_URL and REGISTRY_BACKEND=postgres (startup refuses otherwise).
# API_MULTI_INSTANCE=false
# API_INSTANCE_COUNT=1                       # only divides limits in the explicit local fallback
# INSTANCE_ID=                               # default hostname-pid-random; shown in X-EviReel-Instance
# REDIS_URL=redis://127.0.0.1:6379/0
# REGISTRY_BACKEND=sqlite                    # postgres: videos/jobs/conversations/notes in PostgreSQL
# REGISTRY_DATABASE_URL=                     # default DATABASE_URL; copy existing rows first:
#                                            # python -m vam.storage.pg_registry copy --data-root ... --database-url ...
# REGISTRY_SCHEMA=registry
# PUBLICATION_OBJECTS=true                   # published index/playback files also stored as objects
# READ_LEASE_TTL_S=60                        # read lease, renewed every ttl/3 up to READ_LEASE_MAX_S
# READ_LEASE_MAX_S=900
# GENERATION_RETIRE_GRACE_S=300              # replaced generations are kept this long (and while leased)
# CONVERSATION_LEASE_S=30                    # question ownership; another instance interrupts after expiry
# Model gateway (all instances + workers share these through Redis; -1 disables a limit):
# MODEL_RPM_GLOBAL=600
# MODEL_RPM_PROVIDER=300
# MODEL_TPM_PROVIDER=400000                  # estimated tokens/minute, corrected by provider usage
# MODEL_RPM_WORKSPACE=120
# MODEL_INFLIGHT_PROVIDER=16
# MODEL_INFLIGHT_WORKSPACE=6
# MODEL_INFLIGHT_OFFLINE=10                  # below the provider total: the rest is kept for questions
# MODEL_QUEUE_WAIT_S=5                       # interactive admission wait, then 429
# MODEL_OFFLINE_QUEUE_WAIT_S=120
# MODEL_MAX_WAITERS=64
# MODEL_ATTEMPT_TIMEOUT_S=120
# MODEL_TOTAL_TIMEOUT_S=300
# MODEL_MAX_ATTEMPTS=4
# MODEL_LIMITER_ON_REDIS_ERROR=reject        # reject (503) or local (per-process, limits / API_INSTANCE_COUNT)
# MODEL_DAILY_TOKENS_WORKSPACE=0             # 0 = no default daily budget (model_budgets rows still apply)
# MODEL_PRICES={"model-id": {"input_per_mtok": 1.0, "output_per_mtok": 2.0, "currency": "CNY"}}
# CACHE_ENABLED=true
# CACHE_TTL_S=600
